# Clerk publishable key enables the login and signup buttons.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase project URL used by the signed-in booking form.
NEXT_PUBLIC_SUPABASE_URL=

# EmailJS sends career applications from the static GitHub Pages site.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_BOOKING_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
